# Copy this file to .env and fill in your values
# cp .env.example .env

OPENAI_API_KEY=sk-your-api-key-here
MODEL_NAME=gpt-4o-mini
# Which SYSTEM_PROMPTS entry the agent runs on. Stage 8 compares v1 with v2
# by flipping this and nothing else.
PROMPT_VERSION=v1

# LangSmith tracing. Optional: with LANGSMITH_TRACING unset or false the
# agent behaves exactly as before and sends nothing anywhere.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=lsv2_pt_your_key_here
LANGSMITH_PROJECT=research-agent-hl4
# EU region: https://eu.api.smith.langchain.com -- a key only works in the
# region that issued it, so the wrong endpoint means an empty project.
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Needed only for an organization-scoped key, which LangSmith rejects until
# it knows the workspace. A personal key ignores this.
# LANGSMITH_WORKSPACE_ID=
